# Copy to backend/.env (never committed) and fill in. Google services (Chirp 3, Gemini on
# Vertex AI, Text-to-Speech, Cloud Translation) use Application Default Credentials locally
# (`gcloud auth application-default login`) and the service account on Cloud Run: no keys.
GCP_PROJECT=
GROQ_API_KEY=
OPENAI_API_KEY=
# The hub needs both (hard rule 1); the API token also guards /docs and the API.
# On Cloud Run both come from Secret Manager.
HUB_PIN=
API_TOKEN=
# The token in the family's join link (/join/<token>). On Cloud Run from Secret Manager.
ROOM_TOKEN=
